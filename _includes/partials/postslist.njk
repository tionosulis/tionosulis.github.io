<ol class="postlist" reversed>
{% for post in postslist %}
  <li>
    <a href="{{ post.url }}">{{ post.data.title }}</a>
    <span class="postlist-dots"></span>
    <time class="postlist-date" datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate("yyyy LLL") }}</time>
  </li>
{% endfor %}
</ol>
