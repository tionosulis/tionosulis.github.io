<header class="topbar">
  <a href="/" class="site-logo-link" aria-label="Home">
    <span class="logo-prompt">&gt;_</span><span class="logo-initial">S</span>
  </a>
  <button class="theme-toggle" onclick="toggleTheme()" aria-label="Toggle theme">[dark]</button>
</header>
<script>
function toggleTheme(){var e=document.documentElement.getAttribute("data-theme"),t=e==="dark"?"light":"dark",l=document.querySelectorAll(".theme-toggle,.theme-toggle-posts");document.documentElement.setAttribute("data-theme",t),localStorage.setItem("theme",t),l.forEach(function(n){n.textContent=t==="dark"?"[light]":"[dark]"})}
document.querySelectorAll(".theme-toggle,.theme-toggle-posts").forEach(function(n){n.textContent=document.documentElement.getAttribute("data-theme")==="dark"?"[light]":"[dark]"})
</script>
