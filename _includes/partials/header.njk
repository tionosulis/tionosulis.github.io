<aside class="sidebar">
  {% if page.url == '/' %}
  <h1 class="site-logo"><a href="/" aria-label="Home">S</a></h1>
  {% else %}
  <a href="/" class="site-logo" aria-label="Home">S</a>
  {% endif %}
  <nav class="sidebar-nav">
    <a href="/posts/" {% if '/posts/' in page.url and page.url != '/' %}aria-current="page"{% endif %}>Posts</a>
    <button class="theme-toggle" onclick="toggleTheme()" aria-label="Toggle theme" title="Toggle theme">&#9681;</button>
  </nav>
</aside>
<script>
function toggleTheme(){var e=document.documentElement.getAttribute("data-theme"),t=e==="dark"?"light":"dark",b=document.querySelector(".theme-toggle");document.documentElement.setAttribute("data-theme",t),localStorage.setItem("theme",t),b.setAttribute("title",t==="dark"?"Dark mode":"Light mode")}
var b=document.querySelector(".theme-toggle");b&&b.setAttribute("title",document.documentElement.getAttribute("data-theme")==="dark"?"Dark mode":"Light mode")
</script>
