<!doctype html>
<html lang="{{ metadata.language }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="generator" content="{{ eleventy.generator }}">
  <title>{% if title %}{{ title | safe }}{% else %}{{ metadata.title | safe }}{% endif %}</title>
  <meta name="description" content="{% if description %}{{ description | safe }}{% else %}{{ metadata.description | safe }}{% endif %}">
  <link rel="canonical" href="{{ metadata.url }}{{ page.url }}">
  <link rel="alternate" href="{{ metadata.url }}/feed/feed.xml" type="application/atom+xml" title="{{ metadata.title | safe }}">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.json">
  <link rel="preload" href="/fonts/JetBrainsMono[wght].woff2" as="font" type="font/woff2" crossorigin>
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#161616" media="(prefers-color-scheme: dark)">
  <meta property="og:title" content="{% if title %}{{ title | safe }}{% else %}{{ metadata.title | safe }}{% endif %}">
  <meta property="og:description" content="{% if description %}{{ description | safe }}{% else %}{{ metadata.description | safe }}{% endif %}">
  <meta name="twitter:title" content="{% if title %}{{ title | safe }}{% else %}{{ metadata.title | safe }}{% endif %}">
  <meta name="twitter:description" content="{% if description %}{{ description | safe }}{% else %}{{ metadata.description | safe }}{% endif %}">
  <meta property="og:url" content="{{ metadata.url }}{{ page.url }}">
  <meta property="og:site_name" content="{{ metadata.title | safe }}">
  <meta property="og:type" content="{% if page.url != '/' %}article{% else %}website{% endif %}">
  {% if page.url != '/' and page.date %}
  <meta property="article:published_time" content="{{ page.date | htmlDateString }}">
  {% endif %}
  {% for tag in tags | default([]) %}{% if tag != 'posts' %}
  <meta property="article:tag" content="{{ tag }}">
  {% endif %}{% endfor %}
  {% set ogImage = image or metadata.image %}
  <meta property="og:image" content="{{ metadata.url }}{{ ogImage }}">
  {% if image %}
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:image" content="{{ metadata.url }}{{ image }}">
  <meta name="twitter:image:alt" content="{{ (image_alt or description or metadata.description) | safe }}">
  {% endif %}
  <meta name="twitter:card" content="{% if image %}summary_large_image{% else %}summary{% endif %}">
  {% if metadata.verification.google %}<meta name="google-site-verification" content="{{ metadata.verification.google }}">{% endif %}
  {% if metadata.twitterHandle %}<meta name="twitter:site" content="{{ metadata.twitterHandle }}">{% endif %}
  {% if metadata.twitterHandle and page.url != '/' %}<meta name="twitter:creator" content="{{ metadata.twitterHandle }}">{% endif %}
  {% if ignore %}<meta name="robots" content="noindex">{% endif %}
  <script>var t=localStorage.getItem("theme");if(!t){t=window.matchMedia("(prefers-color-scheme:dark)").matches?"dark":"light"}document.documentElement.setAttribute("data-theme",t)</script>
  <style>{% include "content/assets/css/index.css" %}</style>
</head>
<body>
  <a href="#skip" class="visually-hidden">Skip to main content</a>
  <div class="layout{% if page.url == '/posts/' or '/tags/' in page.url %} layout--posts{% endif %}">
    {% include "partials/header.njk" %}
    <main id="skip">
      {{ content | safe }}
      {% if page.url != '/posts/' and '/tags/' not in page.url %}
      {% include "partials/footer.njk" %}
      {% endif %}
    </main>
  </div>
  <script>navigator.serviceWorker&&navigator.serviceWorker.register("/sw.js")</script>
  <script>document.querySelectorAll(".copy-btn").forEach(b=>{b.addEventListener("click",async()=>{let c=b.parentElement.querySelector("code");if(!c)return;try{await navigator.clipboard.writeText(c.textContent),b.innerHTML=decodeURIComponent(b.dataset.check),b.classList.add("copied"),setTimeout(()=>{b.classList.remove("copied"),b.innerHTML=decodeURIComponent(b.dataset.copy)},2e3)}catch(e){}})});</script>
</body>
</html>
