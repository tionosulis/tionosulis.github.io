---
layout: layouts/base.njk
---
<div class="article-page">
<nav class="breadcrumb" aria-label="Breadcrumb">
  <span class="prompt-char">$</span> <span class="cmd">cat</span> <a href="/">~</a>/<a href="/posts/">posts</a>/<span class="current">{{ page.fileSlug }}.md</span>
</nav>
<article>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "{{ title | escape }}",
  "url": "{{ metadata.url }}{{ page.url }}",
  "datePublished": "{{ page.date | htmlDateString }}",
  "dateModified": "{% if updated %}{{ updated | htmlDateString }}{% else %}{{ page.date | htmlDateString }}{% endif %}",
  "author": {
    "@type": "Person",
    "name": "{{ metadata.author.name }}",
    "url": "{{ metadata.author.url }}"
  }{% if description %},
  "description": "{{ description | escape }}"{% endif %}{% if image %},
  "image": "{{ metadata.url }}{{ image }}"{% endif %}
}
</script>
  <header class="post-header">
    <h1>{{ title }}</h1>
    <div class="post-meta">
      <time datetime="{{ page.date | htmlDateString }}">{{ page.date | readableDate("dd LLLL yyyy") }}</time>
      {% if tags %}
      {% for tag in tags | filterTagList %}
      <a href="/tags/{{ tag | slugify }}/" class="post-tag">{{ tag }}</a>
      {% endfor %}
      {% endif %}
    </div>
  </header>
  {% if redesign_notice %}
  {% include "partials/notice-redesign.njk" %}
  {% endif %}
  <div class="post-divider" aria-hidden="true"></div>
  {{ content | safe }}
  <hr>
  <p class="post-exit" aria-hidden="true">
    <span class="prompt-char">$</span> <span class="cmd">cd</span> ..
  </p>
  <p class="post-exit" aria-hidden="true">
    <span class="prompt-char">$</span> <span class="cmd">ls</span> posts/<span class="cursor">▋</span>
  </p>
</article>
<nav class="links-nextprev">
  <a href="/posts/" class="back-link"><span class="vim-cmd">:q</span> back to posts</a>
  {% if collections.posts %}
  {% set nextPost = collections.posts | getNextCollectionItem(page) %}
  {% set previousPost = collections.posts | getPreviousCollectionItem(page) %}
  {% if nextPost or previousPost %}
  <div class="nav-pair">
    {% if nextPost %}<a href="{{ nextPost.url }}" class="prev"><span class="vim-cmd">:prev</span> {{ nextPost.data.title }}</a>{% endif %}
    {% if previousPost %}<a href="{{ previousPost.url }}" class="next"><span class="vim-cmd">:next</span> {{ previousPost.data.title }}</a>{% endif %}
  </div>
  {% endif %}
  {% endif %}
</nav>
</div>
<script>(function(){var l=document.querySelectorAll('.toc a[href^="#"]');if(!l.length)return;var m=[];l.forEach(function(a){var h=document.getElementById(a.getAttribute('href').slice(1));if(h){h._t=a.parentElement;m.push(h)}a.addEventListener('click',function(){l.forEach(function(x){x.parentElement.classList.remove('is-active')});this.parentElement.classList.add('is-active')})});var s=new Set,v=new IntersectionObserver(function(e){e.forEach(function(e){e.isIntersecting?s.add(e.target):s.delete(e.target)});l.forEach(function(a){a.parentElement.classList.remove('is-active')});var t=Array.from(s).sort(function(a,b){return a.getBoundingClientRect().top-b.getBoundingClientRect().top});if(t.length)t[0]._t.classList.add('is-active');else if(m.length)m[0]._t.classList.add('is-active')},{rootMargin:'-80px 0px -100px',threshold:0});m.forEach(function(h){v.observe(h)});if(m.length)m[0]._t.classList.add('is-active')})();</script>
