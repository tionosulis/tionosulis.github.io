---
layout: layouts/base.njk
permalink: /posts/
title: Posts
---

<div class="posts-page">

  <header class="posts-header">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <span><a href="/">~</a>/posts</span>
      <button class="theme-toggle-posts" onclick="toggleTheme()" aria-label="Toggle theme">
        <span class="toggle-bracket">[</span>
        <span class="toggle-label">--dark</span>
        <span class="toggle-bracket">]</span>
      </button>
    </nav>
    <div class="heading-prompt">
      <span class="prompt-char">$</span>
      <h1>posts</h1>
    </div>
    <p class="subheading">
      <span class="cmd">cat</span> thoughts.log
      <span class="cursor"></span>
    </p>
    <div class="stats-bar">
      <span><strong>{{ collections.posts | length }}</strong> entries</span>
      <span><strong>{{ collections.posts | countTopics }}</strong> topics</span>
      <span>latest <strong>{{ collections.posts | last | getDate("yyyy-MM-dd") }}</strong></span>
    </div>
  </header>

  {% set currentYear = "" %}
  <ol class="post-list">
    {% for post in collections.posts | sortPinned %}
      {% set postYear = post.date | getDate("yyyy") %}
      {% if not post.data.pinned and postYear !== currentYear %}
        <li class="year-label" aria-hidden="true">{{ postYear }}</li>
        {% set currentYear = postYear %}
      {% endif %}
      <li class="post-item{% if post.data.pinned %} pinned{% endif %}">
        <div class="line-sep"></div>
        <div class="post-content">
          <a href="{{ post.url }}" class="post-title">{{ post.data.title }}</a>
          {% if post.data.tags %}
          <div class="post-tags">
            {% for tag in post.data.tags %}
              {% if tag not in ["all", "nav", "post", "posts"] %}<span class="tag">{{ tag }}</span>{% endif %}
            {% endfor %}
          </div>
          {% endif %}
        </div>
        <span class="post-date">{{ post.date | getDate("yyyy-MM-dd") }}</span>
      </li>
    {% endfor %}
  </ol>

  <footer class="page-footer">
    <span><span class="footer-cmd">:q</span> — press esc to go back</span>
    <span>{{ collections.posts | length }} posts</span>
  </footer>

</div>
